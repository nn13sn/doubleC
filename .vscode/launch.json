{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch (CDT GDB)",
      "type": "gdb",
      "request": "launch",
      "program": "${workspaceRoot}/build/DoubleC",
      "arguments": [],
      "gdbpath": "gdb",
      "cwd": "${workspaceRoot}",
      "stopAtEntry": false,
      "commands": [
        "set print pretty on",
        "python import sys; print('GDB Python version:', sys.version)"
      ]
    }
  ]
}
